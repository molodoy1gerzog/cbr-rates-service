[Unit]
Description=CBR rates service
After=network-online.target
Wants=network-online.target

[Service]
User=cbr
Group=cbr
WorkingDirectory=/opt/cbr-rates/src
EnvironmentFile=/opt/cbr-rates/.env
ExecStart=/opt/cbr-rates/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
